# Safe local defaults only. Copy to .env for development; never commit .env.
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://eventory:eventory@localhost:5432/eventory?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=eventory-local-session-secret-change-me
QR_SIGNING_SECRET=eventory-local-qr-signing-secret-change-me
QR_KEY_VERSION=1
MOCK_PAYMENT_WEBHOOK_SECRET=eventory-local-mock-payment-secret-change-me
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SEAT_HOLD_TTL_SECONDS=600
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
MAIL_FROM=no-reply@eventory.local
OUTBOX_WORKER_ENABLED=false
CORS_ORIGINS=http://localhost:3000
POSTGRES_USER=eventory
POSTGRES_PASSWORD=eventory
POSTGRES_DB=eventory
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=eventory-local-grafana-change-me
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
