generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ORGANIZER
  ATTENDEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_OPEN
  SALES_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum SeatAllocationStatus {
  AVAILABLE
  BLOCKED
  SOLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
  REQUIRES_RECONCILIATION
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
}

enum PaymentWebhookInboxStatus {
  RECEIVED
  PROCESSED
  IGNORED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(320)
  displayName        String               @db.VarChar(120)
  passwordHash       String               @db.VarChar(255)
  role               UserRole             @default(ATTENDEE)
  status             UserStatus           @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organizations      OrganizationMember[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[]
  organizationsOwned Organization[]       @relation("OrganizationOwner")
  bookings           Booking[]
  tickets            Ticket[]
  ticketCheckIns     TicketCheckIn[]      @relation("TicketCheckInScanner")

  @@index([status, createdAt])
  @@map("users")
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(160)
  slug      String               @unique @db.VarChar(180)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  venues    Venue[]
  events    Event[]
  ownerId   String?              @db.Uuid
  owner     User?                @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  role           OrganizationMemberRole @default(STAFF)
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@map("organization_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  familyId  String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @db.VarChar(80)
  resourceId   String?  @db.Uuid
  metadata     Json
  ipAddress    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  scope              String   @db.VarChar(120)
  key                String   @db.VarChar(255)
  userId             String?  @db.Uuid
  bookingId          String?  @db.Uuid
  requestFingerprint String?  @db.VarChar(128)
  responseStatus     Int
  responseBody       Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking            Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([userId, expiresAt])
  @@index([bookingId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Venue {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(160)
  address        String?        @db.VarChar(300)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       VenueSection[]
  seats          Seat[]
  events         Event[]

  @@index([organizationId, createdAt])
  @@map("venues")
}

model VenueSection {
  id        String @id @default(uuid()) @db.Uuid
  venueId   String @db.Uuid
  name      String @db.VarChar(120)
  sortOrder Int    @default(0)
  venue     Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats     Seat[]

  @@unique([venueId, name])
  @@index([venueId, sortOrder])
  @@map("venue_sections")
}

model Seat {
  id          String           @id @default(uuid()) @db.Uuid
  venueId     String           @db.Uuid
  sectionId   String           @db.Uuid
  rowLabel    String           @db.VarChar(30)
  seatNumber  Int
  code        String           @db.VarChar(80)
  venue       Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  section     VenueSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  allocations SeatAllocation[]

  @@unique([venueId, code])
  @@unique([sectionId, rowLabel, seatNumber])
  @@index([venueId, sectionId])
  @@map("seats")
}

model Event {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  venueId        String?        @db.Uuid
  name           String         @db.VarChar(200)
  slug           String         @unique @db.VarChar(220)
  description    String?        @db.Text
  timezone       String         @db.VarChar(64)
  startAt        DateTime
  endAt          DateTime
  status         EventStatus    @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue          Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  sessions       EventSession[]
  ticketTypes    TicketType[]

  @@index([status, startAt])
  @@index([organizationId, status, startAt])
  @@map("events")
}

model EventSession {
  id           String           @id @default(uuid()) @db.Uuid
  eventId      String           @db.Uuid
  name         String           @db.VarChar(160)
  startAt      DateTime
  endAt        DateTime
  salesStartAt DateTime
  salesEndAt   DateTime
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  allocations  SeatAllocation[]
  bookings     Booking[]
  tickets      Ticket[]
  checkIns     TicketCheckIn[]

  @@index([eventId, startAt])
  @@index([salesStartAt, salesEndAt])
  @@map("event_sessions")
}

model TicketType {
  id           String           @id @default(uuid()) @db.Uuid
  eventId      String           @db.Uuid
  name         String           @db.VarChar(120)
  description  String?          @db.Text
  priceMinor   Int
  currency     String           @default("VND") @db.Char(3)
  capacity     Int
  soldQuantity Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  allocations  SeatAllocation[]
  bookingItems BookingItem[]

  @@unique([eventId, name])
  @@index([eventId, priceMinor])
  @@map("ticket_types")
}

model SeatAllocation {
  id             String               @id @default(uuid()) @db.Uuid
  eventSessionId String               @db.Uuid
  seatId         String               @db.Uuid
  ticketTypeId   String?              @db.Uuid
  status         SeatAllocationStatus @default(AVAILABLE)
  eventSession   EventSession         @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  seat           Seat                 @relation(fields: [seatId], references: [id], onDelete: Cascade)
  ticketType     TicketType?          @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  bookingItems   BookingItem[]

  @@unique([eventSessionId, seatId])
  @@index([eventSessionId, status])
  @@index([ticketTypeId, status])
  @@map("seat_allocations")
}

model Booking {
  id                 String                 @id @default(uuid()) @db.Uuid
  publicCode         String                 @unique @db.VarChar(32)
  userId             String                 @db.Uuid
  eventSessionId     String                 @db.Uuid
  holdId             String                 @db.Uuid
  status             BookingStatus          @default(PENDING)
  currency           String                 @db.Char(3)
  subtotalMinor      Int
  feeMinor           Int                    @default(0)
  totalMinor         Int
  expiresAt          DateTime
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSession       EventSession           @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  items              BookingItem[]
  payment            Payment?
  tickets            Ticket[]
  outboxEvents       OutboxEvent[]
  notifications      NotificationDelivery[]
  idempotencyRecords IdempotencyRecord[]

  @@unique([holdId])
  @@index([userId, createdAt])
  @@index([eventSessionId, status, createdAt])
  @@index([status, expiresAt])
  @@map("bookings")
}

model BookingItem {
  id               String         @id @default(uuid()) @db.Uuid
  bookingId        String         @db.Uuid
  seatAllocationId String         @db.Uuid
  seatId           String         @db.Uuid
  ticketTypeId     String?        @db.Uuid
  ticketTypeName   String         @db.VarChar(120)
  seatCode         String?        @db.VarChar(80)
  priceMinor       Int
  currency         String         @db.Char(3)
  createdAt        DateTime       @default(now())
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatAllocation   SeatAllocation @relation(fields: [seatAllocationId], references: [id], onDelete: Restrict)
  ticketType       TicketType?    @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticket           Ticket?

  @@unique([bookingId, seatAllocationId])
  @@index([seatAllocationId])
  @@map("booking_items")
}

model Payment {
  id                       String                 @id @default(uuid()) @db.Uuid
  bookingId                String                 @unique @db.Uuid
  provider                 PaymentProvider
  providerReference        String?                @unique @db.VarChar(160)
  providerIdempotencyKey   String                 @unique @db.VarChar(160)
  providerAttemptId        String?                @db.Uuid
  providerAttemptedAt      DateTime?
  providerLastError        String?                @db.VarChar(500)
  status                   PaymentStatus          @default(PENDING)
  amountMinor              Int
  currency                 String                 @db.Char(3)
  clientSecret             String?                @db.VarChar(255)
  expiresAt                DateTime?
  reconciliationRequiredAt DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  booking                  Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events                   PaymentEvent[]
  reconciliation           PaymentReconciliation?

  @@index([status, createdAt])
  @@index([providerAttemptId])
  @@map("payments")
}

model PaymentReconciliation {
  id              String                      @id @default(uuid()) @db.Uuid
  paymentId       String                      @unique @db.Uuid
  providerEventId String                      @unique @db.VarChar(160)
  reason          String                      @db.VarChar(160)
  status          PaymentReconciliationStatus @default(OPEN)
  resolution      String?                     @db.VarChar(500)
  createdAt       DateTime                    @default(now())
  resolvedAt      DateTime?
  payment         Payment                     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payment_reconciliations")
}

model PaymentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  paymentId       String             @db.Uuid
  provider        PaymentProvider
  providerEventId String             @db.VarChar(160)
  eventType       String             @db.VarChar(80)
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  payment         Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

model PaymentWebhookInbox {
  id              String                    @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  providerEventId String                    @db.VarChar(160)
  eventType       String                    @db.VarChar(80)
  reference       String                    @db.VarChar(160)
  amountMinor     Int
  currency        String                    @db.Char(3)
  status          PaymentWebhookInboxStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime                  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_inbox")
}

model Ticket {
  id             String          @id @default(uuid()) @db.Uuid
  bookingId      String          @db.Uuid
  bookingItemId  String          @unique @db.Uuid
  userId         String          @db.Uuid
  eventSessionId String          @db.Uuid
  publicCode     String          @unique @db.VarChar(40)
  qrNonce        String          @unique @default(uuid()) @db.VarChar(80)
  qrKeyVersion   Int             @default(1)
  status         TicketStatus    @default(ISSUED)
  issuedAt       DateTime        @default(now())
  checkedInAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem    BookingItem     @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSession   EventSession    @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  checkIns       TicketCheckIn[]

  @@index([userId, createdAt])
  @@index([eventSessionId, status])
  @@map("tickets")
}

model TicketCheckIn {
  id             String       @id @default(uuid()) @db.Uuid
  ticketId       String       @unique @db.Uuid
  eventSessionId String       @db.Uuid
  scannerUserId  String?      @db.Uuid
  checkedInAt    DateTime     @default(now())
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  scanner        User?        @relation("TicketCheckInScanner", fields: [scannerUserId], references: [id], onDelete: SetNull)

  @@index([eventSessionId, checkedInAt])
  @@index([scannerUserId, checkedInAt])
  @@map("ticket_check_ins")
}

model OutboxEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  topic         String                 @db.VarChar(120)
  aggregateType String                 @db.VarChar(80)
  aggregateId   String                 @db.Uuid
  payload       Json
  status        OutboxStatus           @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now())
  processedAt   DateTime?
  lastError     String?                @db.VarChar(500)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  bookingId     String?                @db.Uuid
  booking       Booking?               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  notifications NotificationDelivery[]

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([bookingId, topic])
  @@map("outbox_events")
}

model NotificationDelivery {
  id            String              @id @default(uuid()) @db.Uuid
  dedupeKey     String              @unique @db.VarChar(200)
  outboxEventId String              @db.Uuid
  bookingId     String?             @db.Uuid
  channel       NotificationChannel
  recipient     String              @db.VarChar(320)
  template      String              @db.VarChar(120)
  payload       Json
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  sentAt        DateTime?
  lastError     String?             @db.VarChar(500)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  outboxEvent   OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  booking       Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, channel])
  @@index([status, nextAttemptAt])
  @@index([bookingId, channel])
  @@map("notification_deliveries")
}
